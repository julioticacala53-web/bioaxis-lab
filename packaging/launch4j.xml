<launch4jConfig>
  <dontWrapJar>true</dontWrapJar>
  <headerType>gui</headerType>
  <jar>app\laboratorio-clinico.jar</jar>
  <outfile>../dist/Laboratorio/Laboratorio.exe</outfile>
  <errTitle>Laboratorio clinico</errTitle>
  <chdir>.</chdir>
  <priority>normal</priority>
  <downloadUrl>https://adoptium.net/</downloadUrl>
  <stayAlive>false</stayAlive>
  <restartOnCrash>false</restartOnCrash>
  <icon>Laboratorio.ico</icon>

  <singleInstance>
    <mutexName>pe.vizcacha.laboratorio</mutexName>
    <windowTitle>Laboratorio cl</windowTitle>
  </singleInstance>

  <jre>
    <path>runtime</path>
    <requires64Bit>true</requires64Bit>
    <opt>-XX:TieredStopAtLevel=1</opt>
    <opt>-XX:+UseSerialGC</opt>
    <opt>-Xms64m</opt>
    <opt>-Dfile.encoding=UTF-8</opt>
    <opt>-Dsun.stdout.encoding=UTF-8</opt>
    <opt>-Dsun.stderr.encoding=UTF-8</opt>
  </jre>

  <splash>
    <file>splash.bmp</file>
    <waitForWindow>true</waitForWindow>
    <timeout>60</timeout>
    <timeoutErr>false</timeoutErr>
  </splash>

  <versionInfo>
    <fileVersion>1.0.0.0</fileVersion>
    <txtFileVersion>1.0.0</txtFileVersion>
    <fileDescription>Sistema de gestion de laboratorio clinico</fileDescription>
    <copyright>Laboratorio clinico</copyright>
    <productVersion>1.0.0.0</productVersion>
    <txtProductVersion>1.0.0</txtProductVersion>
    <productName>Laboratorio clinico</productName>
    <companyName>Laboratorio clinico</companyName>
    <internalName>Laboratorio</internalName>
    <originalFilename>Laboratorio.exe</originalFilename>
  </versionInfo>
</launch4jConfig>
