<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>pe.vizcacha.laboratorio</groupId>
    <artifactId>laboratorio-clinico</artifactId>
    <version>1.0.0</version>
    <name>Laboratorio clinico</name>
    <description>Sistema de gestion de laboratorio clinico</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <sqlite.version>3.46.1.3</sqlite.version>
        <poi.version>5.3.0</poi.version>
        <javafx.version>21.0.4</javafx.version>
        <openpdf.version>2.0.3</openpdf.version>
        <frontend.skip>false</frontend.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- SQLiteDialect: Hibernate no lo trae en el nucleo. La version la
             gestiona el BOM de Spring Boot junto al resto de org.hibernate.orm. -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!--
          Exportaciones REALES a PDF y Excel. El original las simulaba con un
          toast; es una mejora pedida explicitamente por el autor, no paridad,
          y obliga a reescribir los tres toasts que decian "simulada".
        -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${openpdf.version}</version>
        </dependency>

        <!-- La ventana de escritorio: WebView mostrando la misma UI. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
      JavaFX va en el classpath del jar, no en el module-path. Produce un
      aviso al arrancar ("Unsupported JavaFX configuration") y funciona:
      NativeLibLoader extrae las nativas del jar anidado en tiempo de
      ejecucion. Asi el runtime recortado de jlink solo lleva modulos del
      JDK y el empaquetado es mucho mas simple.
    -->
    <profiles>
        <!--
          Empaquetado para Windows.

          La resolucion automatica de OpenJFX solo trae las nativas del
          sistema que compila (aqui, Linux), asi que el jar no arrancaria en
          Windows. Este perfil anade las "win" junto a las locales.

          Fijar la propiedad javafx.platform NO sirve: los POM de OpenJFX la
          definen en sus propios perfiles por sistema operativo y ganan. Las
          nativas de Linux sobrantes, 48 MB, las borra el script de
          empaquetado al desplegar el jar.

            mvn -Pwin clean package
        -->
        <profile>
            <id>win</id>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-web</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-media</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- El .exe arranca por aqui: abre la ventana y levanta
                         Spring detras. Con -Dlaboratorio.sin-ventana=true o en un
                         entorno sin pantalla, se queda en servicio web. -->
                    <mainClass>pe.vizcacha.laboratorio.DesktopLauncher</mainClass>
                </configuration>
            </plugin>

            <!--
              Construccion del frontend (§11.5).

              Va en prepare-package y no en generate-resources a proposito:
              asi `mvn test` no dispara un build de npm cada vez, pero
              `mvn package` siempre empaqueta la interfaz. El resultado se
              copia a target/classes/static, de donde Spring Boot la sirve.

              Usa el npm del sistema (node 22). Para compilar solo el backend:
                  mvn package -Dfrontend.skip=true
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>npm-install</id>
                        <phase>prepare-package</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>npm</executable>
                            <workingDirectory>${project.basedir}/frontend</workingDirectory>
                            <arguments>
                                <argument>ci</argument>
                                <argument>--no-audit</argument>
                                <argument>--no-fund</argument>
                            </arguments>
                            <skip>${frontend.skip}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <phase>prepare-package</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>npm</executable>
                            <workingDirectory>${project.basedir}/frontend</workingDirectory>
                            <arguments>
                                <argument>run</argument>
                                <argument>build</argument>
                            </arguments>
                            <skip>${frontend.skip}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copiar-frontend</id>
                        <phase>prepare-package</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/frontend/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                            <skip>${frontend.skip}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
